{
  "name": "dsh-message-translator",
  "version": "0.1.0",
  "description": "回答をローカルの Ollama で翻訳し、セッションへ記録する DSH プラグイン",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "translation",
    "ollama"
  ],
  "license": "MIT"
}
